				<dict>
					<key>COMMAND_STRING</key>
					<string># Copy the absolute path(s) of the selected Finder items to the clipboard.
# Multiple selections are newline-separated, with no trailing newline.
sep=""
for f in "$@"; do
  printf '%s%s' "$sep" "$f"
  sep=$'\n'
done | pbcopy</string>
