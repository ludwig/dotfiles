# ~/.bashrc_local
# vim: ft=bash

# Added by OrbStack: command-line tools and integration
# This won't be added again if you remove it.
source ~/.orbstack/shell/init.bash 2>/dev/null || :

# Set up powerline-shell prompt
# See https://github.com/b-ryan/powerline-shell
function _update_ps1() {
    export PS1=$(powerline-shell $?)
}
# Uncomment the following line while upgrading powerline-shell
#command -v powerline-shell &>/dev/null &&
if [[ $TERM != linux && ! $PROMPT_COMMAND =~ _update_ps1 ]]; then
   PROMPT_COMMAND="_update_ps1; $PROMPT_COMMAND"
fi

# -----------------------------------------------------------------------------

# Set up z jumper
#source "/usr/local/etc/profile.d/z.sh"
# Use zoxide instead of z jumper
eval "$(zoxide init bash)"

# Set up nvm, lazily. Sourcing nvm.sh cost 0.35-0.6 s per shell: it resolves
# the default alias and runs `node --version`. Instead, put the default node on
# PATH (and MANPATH) the way `nvm use` would, and load nvm on first use.
export NVM_DIR="${HOME}/.nvm"
if [ -s "/usr/local/opt/nvm/nvm.sh" ]; then
    _nvm_lazy_load() {
        unset -f nvm _nvm_lazy_load _nvm_lazy_complete
        source "/usr/local/opt/nvm/nvm.sh"
        if [ -s "/usr/local/opt/nvm/etc/bash_completion.d/nvm" ]; then
            source "/usr/local/opt/nvm/etc/bash_completion.d/nvm"
        fi
    }
    _nvm_default=""
    [ -r "${NVM_DIR}/alias/default" ] && read -r _nvm_default < "${NVM_DIR}/alias/default"
    case "${_nvm_default}" in
        # `node` and `stable` mean the newest installed version
        node|stable) _nvm_default=$(builtin cd "${NVM_DIR}/versions/node" 2>/dev/null &&
                         printf '%s\n' v* | command sort -V | command tail -n 1) ;;
    esac
    if [ -n "${_nvm_default}" ] && [ -x "${NVM_DIR}/versions/node/${_nvm_default}/bin/node" ]; then
        export NVM_BIN="${NVM_DIR}/versions/node/${_nvm_default}/bin"
        export NVM_INC="${NVM_DIR}/versions/node/${_nvm_default}/include/node"
        case ":${PATH}:" in
            *":${NVM_BIN}:"*) ;;
            *) export PATH="${NVM_BIN}:${PATH}" ;;
        esac
        _nvm_man="${NVM_DIR}/versions/node/${_nvm_default}/share/man"
        case ":${MANPATH-}:" in
            *":${_nvm_man}:"*) ;;
            *) export MANPATH="${_nvm_man}:${MANPATH-}" ;;
        esac
        nvm() { _nvm_lazy_load; nvm "$@"; }
        _nvm_lazy_complete() { _nvm_lazy_load; __nvm "$@"; }
        complete -o default -F _nvm_lazy_complete nvm
    else
        # A default alias this cannot resolve cheaply (lts/*, a bare major
        # number): load nvm now and let it decide, as before.
        _nvm_lazy_load
    fi
    unset _nvm_default _nvm_man
fi

# Set up go
# Alternative: go env -w GOBIN=$HOME/bin
export PATH="${PATH}:${HOME}/go/bin"

# Setup cargo
source "$HOME/.cargo/env"

# Set up docker
#export PATH="${HOME}/.docker/bin:${PATH}"
#export DOCKER_BUILDKIT=1
#export COMPOSE_DOCKER_CLI_BUILD=1

# Added by Antigravity
export PATH="/Users/luis/.antigravity/antigravity/bin:$PATH"

# Load macOS aliases
source ~/dotfiles/bash_aliases.macos

# Load dna profile
[ -d ~/config ] && source ~/config/profiles.d/dna.sh

# -----------------------------------------------------------------------------
